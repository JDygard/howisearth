# Copy this file to ".env" and fill in your own values. ".env" is gitignored.

# MongoDB connection string (Atlas: Connect -> Drivers -> Node.js).
MONGODB="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=howIsEarth"

# Optional: days before a read triggers a background refresh from Eurostat (default 7).
# FRESHNESS_DAYS=7

# Optional: server port (default 4000).
# PORT=4000
